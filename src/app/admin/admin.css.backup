.admin-shell{min-height:100vh;background:#05090d;color:#e8f1f4;display:flex;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}.admin-sidebar{width:244px;position:fixed;inset:0 auto 0 0;background:linear-gradient(180deg,#071017,#061117 55%,#07131a);border-right:1px solid rgba(38,101,116,.35);display:flex;flex-direction:column;z-index:50}.brand-row{height:72px;display:flex;align-items:center;gap:10px;padding:0 18px;border-bottom:1px solid rgba(255,255,255,.05)}.brand-logo{width:34px;height:34px;border-radius:10px;background:linear-gradient(145deg,#f6fbfc,#8ad8e4);color:#092027;display:grid;place-items:center;font-weight:900;box-shadow:0 8px 25px rgba(61,211,232,.18)}.brand-row strong{display:block;font-size:14px;letter-spacing:.06em}.brand-row span{display:block;color:#7e969d;font-size:9px;margin-top:2px}.close-mobile{display:none;margin-left:auto;background:none;border:0;color:#a8b9be;font-size:24px}.institution-card{margin:15px 12px 8px;padding:12px;border:1px solid rgba(58,112,125,.25);border-radius:12px;background:rgba(11,35,43,.55);display:flex;gap:10px;align-items:center}.institution-avatar{width:30px;height:30px;border-radius:8px;background:#0e6678;color:#c9f7fc;display:grid;place-items:center;font-weight:800}.institution-card strong{display:block;font-size:11px}.institution-card span{display:block;font-size:9px;color:#759198;margin-top:2px}.sidebar-nav{overflow:auto;padding:8px 10px 18px;flex:1}.nav-group{margin-bottom:12px}.nav-group-title{padding:8px 9px 5px;color:#59747c;font-size:8px;letter-spacing:.18em;font-weight:800}.nav-item{position:relative;display:flex;align-items:center;gap:10px;height:34px;padding:0 11px;border-radius:7px;color:#82979e;text-decoration:none;font-size:10px;margin:2px 0;transition:.2s}.nav-item span{width:18px;text-align:center;color:#7f9ca4}.nav-item:hover{background:rgba(22,82,95,.25);color:#d8eef1}.nav-item.active{background:linear-gradient(90deg,rgba(10,128,149,.55),rgba(8,73,86,.32));color:#dffbff;box-shadow:inset 2px 0 #2dd4df}.nav-item.active span{color:#5ee8ef}.sidebar-premium{margin:10px 12px;padding:14px;border-radius:13px;background:linear-gradient(145deg,#112d36,#0a1a20);border:1px solid rgba(45,212,223,.15)}.premium-icon{font-size:18px;color:#d5a85c}.sidebar-premium strong{display:block;font-size:11px;margin-top:5px}.sidebar-premium p{font-size:9px;color:#789098;line-height:1.5;margin:5px 0 10px}.sidebar-premium button{border:0;background:#0e8a9c;color:white;border-radius:7px;padding:7px 9px;font-size:9px;cursor:pointer}.sidebar-status{padding:13px 15px;border-top:1px solid rgba(255,255,255,.05);display:flex;gap:8px;align-items:center}.sidebar-status i{width:7px;height:7px;background:#2dd4a3;border-radius:50%;box-shadow:0 0 0 4px rgba(45,212,163,.08)}.sidebar-status strong{display:block;font-size:9px}.sidebar-status span{display:block;font-size:8px;color:#607980;margin-top:2px}.admin-main{margin-left:244px;min-height:100vh;flex:1;background:radial-gradient(circle at 85% 0%,rgba(8,91,108,.12),transparent 26%),#05090d}.admin-header{height:72px;display:flex;align-items:center;justify-content:space-between;padding:0 26px;border-bottom:1px solid rgba(255,255,255,.05);background:rgba(5,10,14,.9);position:sticky;top:0;z-index:40;backdrop-filter:blur(16px)}.header-left{display:flex;align-items:center;gap:14px}.menu-button{display:none;background:#0c1b21;border:1px solid #18343d;border-radius:8px;width:36px;height:36px;cursor:pointer}.menu-button span{display:block;width:16px;height:1px;background:#a5c3c9;margin:3px auto}.crumb{font-size:8px;color:#5e7b84;letter-spacing:.05em}.crumb b{color:#7f9ca4;font-weight:500}.header-left h1{font-size:17px;margin:5px 0 0;letter-spacing:-.02em}.header-right{display:flex;align-items:center;gap:8px}.global-search{display:flex;width:260px;background:#09151a;border:1px solid #18343d;border-radius:8px;overflow:hidden}.global-search input{min-width:0;flex:1;border:0;background:transparent;color:#d7e9ed;padding:9px 11px;font-size:9px;outline:none}.global-search button{border:0;background:transparent;color:#6d8991;cursor:pointer}.header-icon{position:relative;width:34px;height:34px;border-radius:8px;background:#09151a;border:1px solid #18343d;color:#8ea9b0;cursor:pointer}.header-icon b{position:absolute;right:-3px;top:-5px;background:#ef7d38;color:white;border-radius:10px;padding:2px 4px;font-size:7px}.profile-wrap,.notification-wrap{position:relative}.profile-btn{display:flex;align-items:center;gap:8px;background:transparent;border:0;color:#dbe8eb;cursor:pointer;text-align:left}.profile-avatar{width:32px;height:32px;border-radius:50%;background:linear-gradient(145deg,#168096,#0b4552);display:grid;place-items:center;font-size:10px;font-weight:800}.profile-btn strong{display:block;font-size:9px}.profile-btn span{display:block;color:#67818a;font-size:8px;margin-top:2px}.profile-btn em{font-style:normal;color:#68828a;margin-left:3px}.dropdown{position:absolute;right:0;top:43px;width:210px;background:#0a171c;border:1px solid #1c3a43;border-radius:10px;box-shadow:0 20px 60px rgba(0,0,0,.4);padding:10px;z-index:100}.dropdown strong{font-size:10px}.dropdown p{font-size:9px;color:#718b92;line-height:1.5}.dropdown button{display:block;width:100%;text-align:left;border:0;background:none;color:#a9c0c5;padding:8px;border-radius:6px;font-size:9px;cursor:pointer}.dropdown button:hover{background:#0e2a32}.admin-content{padding:25px 28px 50px;max-width:1450px;margin:0 auto}.dashboard-welcome{display:flex;justify-content:space-between;gap:25px;padding:24px 25px;border:1px solid #17323a;background:linear-gradient(120deg,#082127,#0a151a);border-radius:13px;box-shadow:0 18px 50px rgba(0,0,0,.16);margin-bottom:18px}.eyebrow{font-size:8px;color:#42d1dc;letter-spacing:.18em;font-weight:800}.dashboard-welcome h2{font-size:25px;margin:8px 0 6px;letter-spacing:-.04em}.dashboard-welcome h2 span{color:#52d9e2}.dashboard-welcome p{margin:0;color:#728b92;font-size:10px;line-height:1.6;max-width:620px}.trial-card{min-width:220px;padding:14px;border-radius:10px;background:#071218;border:1px solid #17323a}.trial-card small,.trial-card span{display:block;color:#63818a;font-size:8px}.trial-card strong{display:block;font-size:11px;margin:7px 0}.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.kpi{position:relative;padding:17px;border:1px solid #162d35;border-radius:11px;background:#081217;text-decoration:none;color:#e7f1f3;min-height:125px;overflow:hidden;transition:.25s}.kpi:hover{transform:translateY(-3px);border-color:#23515c;box-shadow:0 15px 40px rgba(0,0,0,.2)}.kpi:after{content:"";position:absolute;right:-30px;bottom:-50px;width:130px;height:130px;border-radius:50%;background:rgba(58,212,225,.05)}.kpi-icon{width:31px;height:31px;border-radius:8px;display:grid;place-items:center;font-size:13px;margin-bottom:14px}.kpi span{display:block;color:#718990;font-size:9px}.kpi strong{display:block;font-size:23px;margin:4px 0}.kpi small{color:#59727a;font-size:8px}.kpi>b{position:absolute;right:14px;top:14px;color:#4f6e77;font-size:10px}.kpi.purple .kpi-icon{background:#202044;color:#aaa6ff}.kpi.orange .kpi-icon{background:#332418;color:#f6a455}.kpi.green .kpi-icon{background:#10312b;color:#53d4b0}.kpi.red .kpi-icon{background:#341e21;color:#f37e7e}.quick-stats{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin:12px 0}.quick-stat{background:#081217;border:1px solid #152b33;border-radius:9px;padding:13px;text-decoration:none;color:#d9e8eb}.quick-stat strong{display:block;font-size:16px}.quick-stat span{display:block;font-size:8px;color:#607a82;margin-top:3px}.quick-stat.dark{border-left:2px solid #8da5aa}.quick-stat.blue{border-left:2px solid #4eb5e6}.quick-stat.green{border-left:2px solid #45d5a5}.quick-stat.red{border-left:2px solid #ef6f6f}.quick-stat.yellow{border-left:2px solid #e8bb55}.quick-stat.orange{border-left:2px solid #ee8840}.dashboard-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}.panel{background:#081217;border:1px solid #152b33;border-radius:11px;padding:17px}.panel-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.panel-head span,.panel-head>div>span{font-size:7px;color:#4fbec9;letter-spacing:.16em}.panel-head h3{margin:4px 0 0;font-size:13px}.panel-head a,.panel-head>span{font-size:8px;color:#5caeba;text-decoration:none}.list-row{display:flex;align-items:center;gap:9px;padding:9px 0;border-top:1px solid rgba(255,255,255,.04)}.avatar-mini{width:29px;height:29px;border-radius:8px;background:#0e3340;display:grid;place-items:center;color:#78d9e3;font-size:10px;font-weight:800}.list-row div:nth-child(2){flex:1}.list-row strong{display:block;font-size:9px}.list-row span{display:block;color:#627a82;font-size:8px;margin-top:2px}.list-row>b{font-size:7px;color:#51d0b0}.bar-row{padding:8px 0;border-top:1px solid rgba(255,255,255,.04)}.bar-row>div{display:flex;justify-content:space-between;font-size:8px;color:#8099a0}.bar-row b{color:#d0e0e4}.bar-row i{display:block;height:5px;border-radius:10px;background:#10232a;margin-top:6px;overflow:hidden}.bar-row em{display:block;height:100%;background:linear-gradient(90deg,#178c9c,#50d4de);border-radius:10px}.finance-summary{margin-top:12px}.finance-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.finance-grid div{padding:13px;border-radius:9px;background:#071015;border:1px solid #11262e}.finance-grid small{display:block;color:#617980;font-size:8px}.finance-grid strong{display:block;margin-top:6px;font-size:13px}.quick-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.quick-actions a{display:flex;align-items:center;gap:9px;border:1px solid #142c34;border-radius:9px;padding:11px;text-decoration:none;color:#dcecef;transition:.2s}.quick-actions a:hover{background:#0c2229;border-color:#24505b;transform:translateY(-2px)}.quick-actions a>span{width:29px;height:29px;border-radius:7px;background:#0d2b33;color:#55d8e2;display:grid;place-items:center}.quick-actions a div{flex:1}.quick-actions strong{display:block;font-size:8px}.quick-actions small{display:block;color:#5f7880;font-size:7px;margin-top:3px}.quick-actions b{color:#5d7981;font-size:9px}.empty{text-align:center;padding:32px 15px;color:#617a82}.empty>div{margin:0 auto 9px;width:34px;height:34px;border-radius:9px;background:#0d2026;display:grid;place-items:center;color:#3d7380}.empty strong{display:block;color:#a9bdc2;font-size:10px}.empty span{display:block;font-size:8px;margin:5px 0 10px}.empty a{display:inline-block;background:#0d7788;color:#e7fbfe;padding:7px 10px;border-radius:6px;text-decoration:none;font-size:8px}.module-hero{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:16px}.module-hero h2{margin:7px 0 4px;font-size:23px}.module-hero p{margin:0;color:#678088;font-size:9px}.primary-btn{border:0;border-radius:7px;background:linear-gradient(135deg,#0e8799,#1ba8b8);color:#eaffff;padding:9px 13px;font-size:9px;cursor:pointer;box-shadow:0 7px 18px rgba(18,157,175,.13)}.primary-btn:hover{filter:brightness(1.08);transform:translateY(-1px)}.module-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-bottom:12px}.module-metrics>div{padding:13px;background:#081217;border:1px solid #152b33;border-radius:9px}.module-metrics span,.module-metrics small{display:block;color:#617a82;font-size:8px}.module-metrics strong{display:block;font-size:16px;margin:5px 0}.data-panel{background:#081217;border:1px solid #152b33;border-radius:11px;overflow:hidden}.data-toolbar{padding:12px;display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #132831;flex-wrap:wrap}.tabs{display:flex;gap:5px;flex-wrap:wrap}.tabs button,.toolbar-right button,.toolbar-right select{border:1px solid #1b3740;background:#071015;color:#79939a;border-radius:6px;padding:7px 9px;font-size:8px;cursor:pointer}.tabs button.on{background:#0c6e7d;color:#dffbff;border-color:#0f9aac}.toolbar-right{display:flex;gap:6px}.toolbar-right input{width:210px;background:#071015;border:1px solid #1b3740;border-radius:6px;color:#cfe0e4;padding:7px 9px;font-size:8px;outline:none}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:850px}th,td{padding:11px 10px;border-bottom:1px solid rgba(255,255,255,.04);text-align:left;font-size:8px;vertical-align:middle}th{color:#59747c;font-size:7px;letter-spacing:.1em;background:#071015;cursor:pointer}td{color:#a7bac0}td:first-child{color:#4d6871}.pill{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:7px;background:#12252b;color:#8ca4aa}.pill.active,.pill.paid,.pill.present,.pill.published,.pill.received,.pill.issued{background:#0e302a;color:#54d2ae}.pill.inactive,.pill.absent,.pill.cancelled,.pill.rejected,.pill.lost,.pill.blocked{background:#351f23;color:#ed7e7e}.pill.pending,.pill.partial,.pill.follow-up,.pill.new{background:#302717;color:#e7b969}.pill.completed,.pill.converted,.pill.interested{background:#132c3b;color:#62b8e5}.row-actions{display:flex;gap:4px}.row-actions button{width:25px;height:25px;border-radius:6px;border:1px solid #1a353d;background:#0b1a20;color:#80a0a8;font-size:9px;cursor:pointer}.row-actions button:hover{background:#0d2b33;color:#dffaff}.row-actions .danger:hover{color:#ff8b8b;border-color:#63343a}.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.72);display:grid;place-items:center;z-index:200;padding:18px}.modal{width:min(760px,96vw);max-height:90vh;overflow:auto;background:#091419;border:1px solid #21414a;border-radius:13px;box-shadow:0 35px 100px rgba(0,0,0,.5)}.modal-head{padding:16px 18px;border-bottom:1px solid #17313a;display:flex;justify-content:space-between;align-items:center}.modal-head span{font-size:7px;color:#4cc6d1;letter-spacing:.16em}.modal-head h3{margin:5px 0 0;font-size:15px}.modal-head>button{background:none;border:0;color:#719098;font-size:22px;cursor:pointer}.form-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;padding:18px}.form-grid label{display:block;color:#789198;font-size:8px}.form-grid label.full{grid-column:1/-1}.form-grid input,.form-grid select,.form-grid textarea,.settings-card input,.settings-card select{width:100%;box-sizing:border-box;margin-top:6px;background:#061015;border:1px solid #1b3740;border-radius:7px;color:#d8e8eb;padding:9px;font-size:9px;outline:none}.form-grid input:focus,.form-grid select:focus,.form-grid textarea:focus,.settings-card input:focus,.settings-card select:focus{border-color:#1aa1b1;box-shadow:0 0 0 2px rgba(26,161,177,.08)}.modal-actions{display:flex;justify-content:flex-end;gap:8px;padding:14px 18px;border-top:1px solid #17313a}.modal-actions>button:not(.primary-btn){border:1px solid #1b3740;background:#071015;color:#7f999f;border-radius:7px;padding:8px 11px;font-size:8px;cursor:pointer}.detail-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;padding:18px}.detail-grid div{background:#071015;border:1px solid #132a32;border-radius:8px;padding:10px}.detail-grid span{display:block;color:#5d7880;font-size:7px}.detail-grid strong{display:block;color:#d7e5e8;font-size:9px;margin-top:5px;word-break:break-word}.report-summary{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-bottom:13px}.report-summary>div{padding:13px;background:#081217;border:1px solid #152b33;border-radius:9px}.report-summary b{display:block;color:#d9e9ec;font-size:15px}.report-summary span{display:block;color:#617b83;font-size:8px;margin-top:4px}.report-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.report-card{padding:16px;background:#081217;border:1px solid #152b33;border-radius:11px}.report-card>span{font-size:8px;color:#52cbd6;letter-spacing:.12em}.report-card h3{font-size:11px;margin:6px 0 13px;color:#d7e8eb}.report-card>div{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.report-card a{display:flex;justify-content:space-between;padding:8px;background:#071015;border:1px solid #122830;border-radius:6px;color:#79959d;text-decoration:none;font-size:7px}.report-card a:hover{color:#d8f5f7;border-color:#21515b}.report-card button{margin-top:12px;border:1px solid #1a3a43;background:#0b2027;color:#75a3ac;border-radius:6px;padding:7px 9px;font-size:8px;cursor:pointer}.settings-card{background:#081217;border:1px solid #152b33;border-radius:11px;padding:18px}.settings-title{margin-bottom:15px}.settings-title span{font-size:7px;color:#50cbd5;letter-spacing:.15em}.settings-title h3{margin:5px 0 0;font-size:14px}.notification-list{padding:0}.notification-row{display:flex;gap:12px;align-items:flex-start;padding:15px;border-bottom:1px solid rgba(255,255,255,.04)}.notification-row>div{width:30px;height:30px;border-radius:8px;background:#0d2b33;color:#5bd8e2;display:grid;place-items:center}.notification-row section{flex:1}.notification-row strong{font-size:9px}.notification-row p{font-size:8px;color:#627b83;margin:5px 0 0}.notification-row>span{font-size:7px;color:#c59d59}.large{padding:90px 20px}.dark-more{filter:brightness(1.15)}
@media(max-width:1100px){.admin-sidebar{width:220px}.admin-main{margin-left:220px}.kpi-grid{grid-template-columns:repeat(2,1fr)}.quick-stats{grid-template-columns:repeat(3,1fr)}.global-search{width:190px}.report-grid{grid-template-columns:1fr}}
@media(max-width:800px){.admin-sidebar{transform:translateX(-100%);transition:.25s;width:250px}.admin-sidebar.open{transform:translateX(0)}.admin-main{margin-left:0}.menu-button{display:block}.close-mobile{display:block}.mobile-overlay{position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:45;border:0}.admin-header{padding:0 14px}.global-search{display:none}.profile-btn>div:nth-child(2),.profile-btn em{display:none}.admin-content{padding:18px 14px 35px}.dashboard-welcome{display:block}.trial-card{margin-top:15px}.dashboard-grid{grid-template-columns:1fr}.finance-grid{grid-template-columns:repeat(2,1fr)}.quick-actions{grid-template-columns:1fr 1fr}.module-metrics{grid-template-columns:repeat(2,1fr)}.report-summary{grid-template-columns:repeat(2,1fr)}.form-grid{grid-template-columns:1fr}.detail-grid{grid-template-columns:1fr}.module-hero{align-items:flex-start;flex-direction:column}}
@media(max-width:520px){.kpi-grid,.quick-stats,.finance-grid,.quick-actions,.module-metrics,.report-summary{grid-template-columns:1fr}.dashboard-welcome h2{font-size:21px}.dashboard-welcome{padding:18px}.panel{padding:13px}.toolbar-right{width:100%}.toolbar-right input{flex:1}.data-toolbar{padding:9px}.admin-header{height:62px}.header-left h1{font-size:15px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important;animation:none!important}}
.hero-actions{display:flex;gap:7px}.secondary-btn{border:1px solid #1b3740;border-radius:7px;background:#071015;color:#8aa4aa;padding:9px 12px;font-size:9px;cursor:pointer}.secondary-btn:hover{background:#0d2027;color:#d6f0f3}
@media print{.admin-sidebar,.admin-header,.module-hero .hero-actions,.data-toolbar,.row-actions{display:none!important}.admin-main{margin-left:0}.admin-content{padding:0}.data-panel,.panel,.kpi,.module-metrics>div{border-color:#ddd!important;background:#fff!important;color:#111!important}body{background:#fff!important}}
.context-actions{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 12px}.context-actions a{display:flex;align-items:center;gap:8px;padding:8px 10px;border:1px solid #16333b;border-radius:7px;background:#071116;color:#7da0a8;text-decoration:none;font-size:8px}.context-actions a:hover{background:#0d252c;color:#dff9fb;border-color:#24535e}.context-actions b{font-size:8px;color:#4cbfcb}
